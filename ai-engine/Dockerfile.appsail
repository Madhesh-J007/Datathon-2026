# AI Engine AppSail image built from the repository root.
# Includes training CSVs that docker-compose normally mounts at /database.
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc \
    && rm -rf /var/lib/apt/lists/*

COPY ai-engine/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY ai-engine/ .
COPY database/seeds/data /database/seeds/data

EXPOSE 8100
CMD ["uvicorn", "serving.main:app", "--host", "0.0.0.0", "--port", "8100"]
